{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "literacy-guide-media",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "literacy-guide-media" }],
  "observability": { "enabled": false }
}
