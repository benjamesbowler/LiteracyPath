# Vercel builds the app itself — never upload local build output or deps
dist/
dist-ssr/
node_modules/
.vercel

# Large local-only working assets (not needed for the site build)
LP Assets/
raw/
# The release-status generator needs this one machine-readable assessment
# manifest during `npm run build`. Ignore every other documentation file while
# leaving the parent directories traversable so the exception is honoured.
docs/*
!docs/skills-assessment-rebuild/
docs/skills-assessment-rebuild/*
!docs/skills-assessment-rebuild/MEDIA_REQUEST.json
graphify-out/
Phonics app extension/
public_domain_books/

# Test + tooling output
test-results/
playwright-report/
# The production security gate needs these tests. Keep parent directories
# traversable so the exceptions survive Vercel's build-input filtering.
tests/*
!tests/unit/
tests/unit/*
!tests/unit/csvCell.test.js
!tests/unit/privateSourceMapDirectory.test.js
!tests/unit/learnGamesProgressSecurity.test.js
!tests/unit/databasePolicyContract.test.js
!tests/unit/hostedSchemaDriftContract.test.js
!tests/unit/studentLoginPolicy.test.js

# Cruft
*.log
.DS_Store
*.zip
~$*

# NOTE: public/, src/, tools/, index.html, vite.config.js and package files
# are intentionally NOT ignored — the build needs them.
